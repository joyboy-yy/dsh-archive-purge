{
  "name": "dsh-archive-purge",
  "version": "1.0.2",
  "description": "无论侧栏「归档显示」如何设置，已归档会话都强制不出现在会话列表；提供统一管理面板，可取消归档，或彻底删除会话日志目录、归档与置顶登记及投影缓存。Force-hides archived DSH sessions and adds a panel to unarchive them or delete them permanently.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "archive",
    "archived-sessions",
    "session",
    "delete",
    "purge"
  ],
  "author": {
    "name": "joyboy-yy",
    "url": "https://github.com/joyboy-yy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyboy-yy/dsh-archive-purge.git"
  },
  "homepage": "https://github.com/joyboy-yy/dsh-archive-purge#readme",
  "bugs": {
    "url": "https://github.com/joyboy-yy/dsh-archive-purge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  }
}
